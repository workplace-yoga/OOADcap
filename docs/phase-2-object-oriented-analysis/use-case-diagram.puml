@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam monochrome false
skinparam shadowing true

actor "Admin" as Admin
actor "Faculty" as Faculty
actor "Student" as Student
actor "User" as User

Admin -up-|> User
Faculty -up-|> User
Student -up-|> User

rectangle "Student Information System (SIS)" {
    usecase "UC-01: Authenticate User" as UC01
    usecase "UC-02: View Role Dashboard" as UC02
    
    usecase "UC-03: Manage Students" as UC03
    usecase "UC-04: Manage Faculty" as UC04
    usecase "UC-05: Manage Courses" as UC05
    usecase "UC-06: Assign Faculty to Course" as UC06
    usecase "UC-07: Manage Course Enrollment" as UC07
    usecase "UC-08: View Institutional Reports" as UC08
    
    usecase "UC-09: View Assigned Courses & Rosters" as UC09
    usecase "UC-10: Record Session Attendance" as UC10
    usecase "UC-11: Update Session Attendance" as UC11
    usecase "UC-12: Enter Assessment Marks" as UC12
    usecase "UC-13: Update Assessment Marks" as UC13
    usecase "UC-14: View Course Academic Performance" as UC14
    
    usecase "UC-15: View Personal Profile" as UC15
    usecase "UC-16: View Enrolled Courses" as UC16
    usecase "UC-17: View Personal Attendance" as UC17
    usecase "UC-18: View Academic Records & Grades" as UC18
}

' Common relationships
User --> UC01
UC02 .> UC01 : <<include>>

' Admin relationships
Admin --> UC02
Admin --> UC03
Admin --> UC04
Admin --> UC05
Admin --> UC06
Admin --> UC07
Admin --> UC08

' Faculty relationships
Faculty --> UC02
Faculty --> UC09
Faculty --> UC10
Faculty --> UC12
Faculty --> UC14
UC11 .> UC10 : <<extend>>
UC13 .> UC12 : <<extend>>
UC10 .> UC09 : <<include>>
UC12 .> UC09 : <<include>>

' Student relationships
Student --> UC02
Student --> UC15
Student --> UC16
Student --> UC17
Student --> UC18

@enduml\n